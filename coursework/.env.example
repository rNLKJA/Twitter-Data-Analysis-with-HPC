# Optional: email the run log when main.py is invoked with `-e rin` or `-e wei`.
# Copy to coursework/.env (never commit it) and export the values before running,
# e.g. `set -a; source .env; set +a`. Leave blank to disable log emails.
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
LOG_EMAIL_RIN=
LOG_EMAIL_WEI=
