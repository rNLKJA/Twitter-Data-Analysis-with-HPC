{
  "name": "comp90024-spartan-twitter",
  "version": "0.1.0",
  "private": true,
  "description": "Spartan Tweet Cruncher: interactive revival of COMP90024 Assignment 1 (MPI Twitter analytics on Spartan HPC).",
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:synthetic": "tsx scripts/write-synthetic.ts",
    "run:pipeline": "tsx scripts/run-pipeline.ts",
    "sync-docs": "node scripts/sync-docs.mjs",
    "coverage-sim": "COVERAGE_SIM=1 vitest run src/lib/lab/coverage.sim.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.1",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
